FROM debian:13.6-slim
# https://wiki.debian.org/DebianReleases

# Use bash for the shell (default is sh)
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# Set environment variables
ENV USERNAME=root \
    HOME_DIR="/root" \
    DOTNET_ROOT=/opt/dotnet \
    DEBIAN_FRONTEND=noninteractive \
    NODE_VERSION=24.11.1 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# Update PATH once with all directories
ENV PATH="/usr/local/bin:/opt/dotnet:/opt/dotnet/tools:/root/.local/bin:/root/.dotnet/tools:$PATH"

# Install all system dependencies FIRST
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    # DON'T EVER INSTALL sudo FOR A PRODUCTION CONTAINER!
    sudo \
    # Shells & terminal multiplexer
    bash \
    zsh \
    tmux \
    # Core utilities
    curl \
    wget \
    grep \
    jq \
    tree \
    unzip \
    stow \
    procps \
    gettext-base \
    # Security / TLS
    ca-certificates \
    gnupg \
    lsb-release \
    libssl-dev \
    libffi-dev \
    # Build tools
    build-essential \
    gcc \
    libc6-dev \
    make \
    cargo \
    # Python
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    # Dev tools
    git \
    openssh-client \
    ripgrep \
    xclip \
    # X11 / VNC / virtual display
    xvfb \
    x11vnc \
    novnc \
    websockify \
    # Locale support
    locales && \
    # Generate C.UTF-8 (always available) and en_US.UTF-8
    sed -i '/en_US.UTF-8/s/^# //' /etc/locale.gen && \
    locale-gen && \
    update-locale LANG=C.UTF-8 LC_ALL=C.UTF-8 && \
    rm -rf /var/lib/apt/lists/*

# Root is required for Docker-heavy devmachine workflows.
# Keep the image simple by not creating an alternate user.

# Debian's /etc/profile unconditionally resets PATH for root on login shells
# (bash -l, su -, ssh), which would otherwise drop /opt/dotnet, the dotnet
# global-tools dir, etc. Re-assert PATH via /etc/profile.d so it survives
# regardless of shell or login mode.
RUN echo 'export PATH="'"$PATH"'"' > /etc/profile.d/00-devmachine-path.sh && \
    chmod +x /etc/profile.d/00-devmachine-path.sh

# Install latest nvim
RUN NVIM_FILE="nvim-linux-arm64.tar.gz" && \
    echo "Installing Neovim for ARM64 (Mac M3)..." && \
    curl -LO "https://github.com/neovim/neovim/releases/latest/download/${NVIM_FILE}" && \
    tar -C /opt -xzf "${NVIM_FILE}" && \
    rm "${NVIM_FILE}" && \
        # Link the binary to /usr/local/bin so it's globally available - remember to add '/usr/local/bin/' to path!
    ln -s /opt/nvim-linux-arm64/bin/nvim /usr/local/bin/nvim

# Install .NET SDK and runtimes (consolidated into one layer, fixed versions)
RUN curl -sSL https://dot.net/v1/dotnet-install.sh -o dotnet-install.sh && \
    chmod +x dotnet-install.sh && \
    ./dotnet-install.sh --version 10.0.100 --install-dir $DOTNET_ROOT && \
    ./dotnet-install.sh --runtime dotnet --version 8.0.18 --install-dir $DOTNET_ROOT && \
    ./dotnet-install.sh --runtime aspnetcore --channel 9.0 --install-dir $DOTNET_ROOT && \
    # ./dotnet-install.sh --version 9.0.307 --install-dir $DOTNET_ROOT && \
    rm dotnet-install.sh

# Stay root for the full devmachine build so Docker and system tools work without permission issues.
USER root
WORKDIR $HOME_DIR

# Install nvm + Node and expose binaries system-wide
ENV NVM_DIR=/root/.nvm
RUN curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash && \
    . "$NVM_DIR/nvm.sh" && \
    nvm install "$NODE_VERSION" && \
    nvm alias default "$NODE_VERSION" && \
    nvm use default && \
    node_bin="$NVM_DIR/versions/node/$(nvm version default)/bin" && \
    ln -sf "$node_bin/node" /usr/local/bin/node && \
    ln -sf "$node_bin/npm"  /usr/local/bin/npm && \
    ln -sf "$node_bin/npx"  /usr/local/bin/npx

# Install user-specific tools in one layer
RUN sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" && \
    git clone --depth=1 https://github.com/romkatv/powerlevel10k.git "$HOME_DIR/.oh-my-zsh/custom/themes/powerlevel10k" && \
    dotnet tool install --global csharp-ls && \
    dotnet tool install --global dotnet-script && \
    dotnet tool install --global csharpier && \
    dotnet tool install --global dotnet-format && \
    npm install --global yarn


